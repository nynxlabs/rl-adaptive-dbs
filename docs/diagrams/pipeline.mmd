%% How we check: every panel is rebuilt from the paper and scored against
%% curves digitized from the paper's own figure.
flowchart LR
  P["paper text + figures"]:::input --> S["spec<br/>docs/plant · docs/controllers"]:::input
  P --> D["digitized paper curves"]:::input
  S --> M["plant: Kumaravelu model"]:::plant
  M --> T["train controller"]:::train
  T --> F["panel plot"]:::train
  F --> G{{"gates"}}:::gate
  D --> G
  G -- "all pass" --> R["figure page + tracker:<br/>replicated"]:::tracker
  G -- "any fail" --> S

  classDef input fill:#8caaee,stroke:#8caaee,color:#232634
  classDef plant fill:#a6d189,stroke:#a6d189,color:#232634
  classDef train fill:#ef9f76,stroke:#ef9f76,color:#232634
  classDef gate fill:#ca9ee6,stroke:#ca9ee6,color:#232634
  classDef tracker fill:#81c8be,stroke:#81c8be,color:#232634
