# Template: install-wsl-hostid-persist.sh fills in the checkout path at install time.
[Unit]
Description=MATLAB WSL stable Host ID (bond0 MAC for node-locked license)
Documentation=file:@REPO_ROOT@/docs/matlab.md
After=network-pre.target
Before=network-online.target
DefaultDependencies=no
ConditionPathExists=@REPO_ROOT@/scripts/matlab/ensure-wsl-hostid.sh

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash @REPO_ROOT@/scripts/matlab/ensure-wsl-hostid.sh

[Install]
WantedBy=multi-user.target
