[Unit]
Description=MATLAB WSL stable Host ID (bond0 MAC for node-locked license)
Documentation=file:/path/to/rl-adaptive-dbs/docs/matlab.md
After=network-pre.target
Before=network-online.target
DefaultDependencies=no
ConditionPathExists=/path/to/rl-adaptive-dbs/scripts/matlab/ensure-wsl-hostid.sh

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash /path/to/rl-adaptive-dbs/scripts/matlab/ensure-wsl-hostid.sh

[Install]
WantedBy=multi-user.target
